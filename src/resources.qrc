<RCC>
  <qresource prefix="/qml">
    <file alias="Main.qml">qml/Main.qml</file>
    <file alias="Theme.qml">qml/Theme.qml</file>
    <file alias="SettingsDialog.qml">qml/SettingsDialog.qml</file>
    <file alias="dwcode-wordmark.png">assets/dwcode-wordmark.png</file>
    <file alias="dwcode-icon.png">assets/dwcode-icon.png</file>
  </qresource>
  <qresource prefix="/data"><file alias="themes.json">data/themes.json</file></qresource>
</RCC>
